# Resend
RESEND_API_KEY=

# Contact destination and sender identities
CONTACT_EMAIL_TO=info@omeryigitler.com
CONTACT_NOTIFICATION_FROM=Ömer Yiğitler Website <notifications@omeryigitler.com>
CONTACT_RECEIPT_FROM=Ömer Yiğitler <notifications@omeryigitler.com>

# Legacy fallback. Keep empty when the two dedicated sender variables above are set.
CONTACT_EMAIL_FROM=

# Recommended after mail.omeryigitler.com is verified in Resend:
# CONTACT_NOTIFICATION_FROM=Ömer Yiğitler Website <notifications@mail.omeryigitler.com>
# CONTACT_RECEIPT_FROM=Ömer Yiğitler <notifications@mail.omeryigitler.com>

# Backend Firebase service account (never expose in browser bundles)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Contact verification and rate limiting
TURNSTILE_SECRET=
TURNSTILE_ALLOWED_HOSTS=omeryigitler.com,www.omeryigitler.com
RATE_LIMIT_HASH_SECRET=

# Admin / Agent authorization
AGENT_ADMIN_UIDS=
AGENT_ADMIN_EMAILS=
AGENT_API_SECRET=
STARTPAGE_ADMIN_EMAILS=
STARTPAGE_GOOGLE_CLIENT_IDS=

# Telegram / Gemini (optional features)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_IDS=
TELEGRAM_WEBHOOK_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=
AGENT_TIMEZONE=Europe/Istanbul

# Instagram
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_VERSION=
INSTAGRAM_FEED_LIMIT=6

# Passkeys: configure for the actual deployment origin
PASSKEY_RP_ID=omeryigitler.com
PASSKEY_ORIGINS=https://omeryigitler.com
PASSKEY_CHALLENGE_SECRET=
PASSKEY_SETUP_TOKEN=
PASSKEY_CREDENTIALS=

# Optional local build override; absolute path to installed Chromium
SOCIAL_PREVIEW_CHROMIUM_PATH=
# Optional server-side PDF override
PDF_BASE_URL=
PDF_RENDER_MODE=html
