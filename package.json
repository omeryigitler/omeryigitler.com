{
  "name": "omeryigitler.com",
  "version": "1.1.3",
  "description": "Personal portfolio, project archive and private client operations dashboard",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:react": "vite build",
    "build:css": "npx tailwindcss -i ./src/input.css -o ./assets/css/styles.css --minify",
    "watch:css": "npx tailwindcss -i ./src/input.css -o ./assets/css/styles.css --watch",
    "build": "npm run build:admin && npm run build:react && npm run build:css && npm run build:pricing && node scripts/generate-social-preview.js && node scripts/prepare-public.js",
    "deploy": "vercel --prod",
    "test": "node --test test/*.test.js",
    "quality": "npm run test && npm run typecheck && npm run check:syntax && npm run build",
    "postinstall": "npm ci --prefix pricing-tool --no-audit --no-fund",
    "build:admin": "node scripts/build-admin.js",
    "build:pricing": "npm run build --prefix pricing-tool",
    "typecheck": "tsc --noEmit",
    "check:syntax": "node scripts/check-syntax.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omeryigitler/omeryigitler.com.git"
  },
  "keywords": [],
  "author": "Ömer Yiğitler",
  "license": "UNLICENSED",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@simplewebauthn/server": "^13.3.0",
    "@sparticuz/chromium": "^143.0.4",
    "axios": "^1.6.0",
    "firebase-admin": "^12.0.0",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "puppeteer-core": "^24.36.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.0.12",
    "firebase-tools": "^15.4.0",
    "vercel": "^50.1.0"
  },
  "bugs": {
    "url": "https://github.com/omeryigitler/omeryigitler.com/issues"
  },
  "homepage": "https://github.com/omeryigitler/omeryigitler.com#readme",
  "private": true
}
