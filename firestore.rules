rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.admin == true &&
        request.auth.token.role == 'admin';
    }

    // Contact submissions are written only by the server-side Admin SDK.
    // Browser clients cannot create, read, update, or delete inbox records.
    match /messages/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /system_reports/{docId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // Visitor telemetry remains authenticated. Admin-only collection listing and deletion.
    match /visitors_v1/{docId} {
      allow create, update: if isSignedIn();
      allow get: if isSignedIn();
      allow list, delete: if isAdmin();
    }

    // Gateway records are exclusively managed by backend Admin SDK / verified admin sessions.
    match /auth_requests/{docId} {
      allow read, write: if isAdmin();
    }

    match /gateway_handoffs/{docId} {
      allow read, write: if isAdmin();
    }

    match /gateway_handoff_audit/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /gateway_rate_limits/{docId} {
      allow read, write: if false;
    }

    match /projects/{docId} {
      allow read, write: if isAdmin();
    }

    match /quotes/{docId} {
      allow read, write: if isAdmin();
    }

    match /clients/{docId} {
      allow read, write: if isAdmin();
    }

    match /stats/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /security_config/{docId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
