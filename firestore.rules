rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // messages: herkes yazabilir (contact form), sadece auth okuyabilir
    match /messages/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // visitors_v1: sadece auth okuyabilir/yazabilir
    match /visitors_v1/{docId} {
      allow read, write: if request.auth != null;
    }

    // authrequests: herkes oluşturabilir (gateway), sadece auth okuyabilir
    match /authrequests/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // projects, quotes, clients, stats: sadece auth
    match /projects/{docId} {
      allow read, write: if request.auth != null;
    }
    match /quotes/{docId} {
      allow read, write: if request.auth != null;
    }
    match /clients/{docId} {
      allow read, write: if request.auth != null;
    }
    match /stats/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /securityconfig/{docId} {
      allow read, write: if request.auth != null;
    }

    // Diğer her şey kapalı
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
