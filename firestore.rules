rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // CLIENTS COLLECTION (Phase 1)
    // ============================================
    match /clients/{clientId} {
      // Allow authenticated users to read and write
      allow read, write: if request.auth != null;
    }
    
    // ============================================
    // MESSAGES COLLECTION (Updated for clientId)
    // ============================================
    match /messages/{messageId} {
      // Allow anyone to create (contact form submissions)
      allow create: if true;
      // Allow authenticated users to read, update, delete
      allow read, update, delete: if request.auth != null;
    }
    
    // ============================================
    // PROJECTS COLLECTION (When migrated from localStorage)
    // ============================================
    match /projects/{projectId} {
      // Allow authenticated users to read and write
      allow read, write: if request.auth != null;
    }
    
    // ============================================
    // QUOTES COLLECTION (Phase 2 - Future)
    // ============================================
    match /quotes/{quoteId} {
      // Allow authenticated users to read and write
      allow read, write: if request.auth != null;
    }
    
    // ============================================
    // OTHER EXISTING COLLECTIONS
    // ============================================
    
    // Security Config (Admin only - no changes)
    match /security_config/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Visitor Intelligence
    match /visitors/{visitorId} {
      // Allow writing without auth for tracking
      allow write: if true;
      // Reading requires auth
      allow read: if request.auth != null;
    }
    
    // Contact Messages (keep existing rules)
    match /contact-messages/{messageId} {
      // Allow writing without auth (contact form)
      allow write: if true;
      // Reading requires auth
      allow read: if request.auth != null;
    }
  }
}
