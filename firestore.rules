rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Messages Collection - Write-only for public, Read-only for authenticated admins
    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'message', 'timestamp'])
                    && request.resource.data.name is string;
      allow read, update, delete: if request.auth != null;
    }
    
    // Stats Collection
    match /stats/{docId} {
      allow read, write: if true;
    }
    
    // Auth Requests - Handshake for Gateway
    match /auth_requests/{requestId} {
      allow read, write: if true;
    }

    // Visitors Tracking - Tracker Commands
    // REQUIRED for Local Fallback to work
    match /visitors_v1/{sessionId} {
      allow read, write: if true;
    }
    
    // Security Config
    match /security_config/{docId} {
      allow read: if true; 
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
