rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Public contact form can create messages. Admin session is required to read or manage them.
    match /messages/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Tracker/system telemetry is intentionally separated from customer inbox messages.
    match /system_reports/{docId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // Public visitor tracker writes with anonymous Firebase Auth.
    // The browser may listen only to its own known session document for remote commands.
    // Collection listing and deletes stay admin-only.
    match /visitors_v1/{docId} {
      allow create, update: if isSignedIn();
      allow get: if isSignedIn();
      allow list, delete: if isAdmin();
    }

    // Gateway auth requests are written/read by backend Admin SDK.
    match /auth_requests/{docId} {
      allow read, write: if isAdmin();
    }

    // Admin workspace data.
    match /projects/{docId} {
      allow read, write: if isAdmin();
    }

    match /quotes/{docId} {
      allow read, write: if isAdmin();
    }

    match /clients/{docId} {
      allow read, write: if isAdmin();
    }

    match /stats/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /security_config/{docId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
